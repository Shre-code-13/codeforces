import java.util.*;

public class string {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();

        while (n-- > 0) {
            String s = sc.next();
            String t = sc.next();

            StringBuilder ans = new StringBuilder();
            int len = Math.max(s.length(), t.length());

            for (int i = 0; i < len; i++) {
                if (i < s.length()) ans.append(s.charAt(i));
                if (i < t.length()) ans.append(t.charAt(i));
            }

            System.out.println(ans);
        }
    }
}
