import java.util.*;

public class string {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        String a = sc.next();
        String b = sc.next();

        System.out.println(a.length() + " " + b.length());
        System.out.println(a + b);

        System.out.println(b.charAt(0) + a.substring(1) + " " +
                a.charAt(0) + b.substring(1));
    }
}
