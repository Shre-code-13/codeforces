import java.util.*;

public class string {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

            String s = sc.next();
            int[]a=new int[26];

            for (int i=0;i<s.length();i++){
                char ch=s.charAt(i);
                a[ch-'a']++;
            }
            for (int i=0;i<26;i++)
                if(a[i]>0)
                    System.out.println((char)(i+'a') + " : " + a[i]);
            }

    }
