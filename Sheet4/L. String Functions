import java.util.*;
import java.io.*;

public class string {
    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        StringTokenizer st = new StringTokenizer(br.readLine());

        int n = Integer.parseInt(st.nextToken());
        int q = Integer.parseInt(st.nextToken());

        StringBuilder sb = new StringBuilder(br.readLine().trim());
        StringBuilder out = new StringBuilder();

        while (q-- > 0) {
            st = new StringTokenizer(br.readLine());
            String query = st.nextToken();

            switch (query) {
                case "pop_back":
                    sb.deleteCharAt(sb.length() - 1);
                    break;

                case "front":
                    out.append(sb.charAt(0)).append("\n");
                    break;

                case "back":
                    out.append(sb.charAt(sb.length() - 1)).append("\n");
                    break;

                case "sort": {
                    int l = Integer.parseInt(st.nextToken());
                    int r = Integer.parseInt(st.nextToken());
                    if (l > r) { int temp = l; l = r; r = temp; }

                    char[] sub = sb.substring(l - 1, r).toCharArray();
                    Arrays.sort(sub);
                    sb.replace(l - 1, r, new String(sub));
                    break;
                }

                case "reverse": {
                    int l = Integer.parseInt(st.nextToken());
                    int r = Integer.parseInt(st.nextToken());
                    if (l > r) { int temp = l; l = r; r = temp; }

                    StringBuilder sub = new StringBuilder(sb.substring(l - 1, r));
                    sub.reverse();
                    sb.replace(l - 1, r, sub.toString());
                    break;
                }

                case "print": {
                    int pos = Integer.parseInt(st.nextToken());
                    out.append(sb.charAt(pos - 1)).append("\n");
                    break;
                }

                case "substr": {
                    int l = Integer.parseInt(st.nextToken());
                    int r = Integer.parseInt(st.nextToken());
                    if (l > r) { int temp = l; l = r; r = temp; }

                    out.append(sb.substring(l - 1, r)).append("\n");
                    break;
                }

                case "push_back": {
                    char x = st.nextToken().charAt(0);
                    sb.append(x);
                    break;
                }
            }
        }

        System.out.print(out.toString());
    }
}
