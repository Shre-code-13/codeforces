import java.util.*;

public class string {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int t = sc.nextInt();

        while (t-- > 0) {
            String s = sc.next();
            boolean good = false;

            for (int i = 0; i <= s.length() - 3; i++) {
                String sub = s.substring(i, i + 3);

                if (sub.equals("010") || sub.equals("101")) {
                    good = true;
                    break;
                }
            }

            System.out.println(good ? "Good" : "Bad");
        }
    }
}
